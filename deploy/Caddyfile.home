# Caddy for "playing from home" (docker-compose.home.yml, docs/choi-online.md): cloudflared
# brings players in over HTTPS and hands each request to this Caddy over plain HTTP on
# 127.0.0.1. Same routes as deploy/Caddyfile; only the forwarded headers differ.
#
# Chain: player -> Cloudflare -> cloudflared (on this Mac) -> Caddy -> Django.
# - Players always reach Cloudflare over HTTPS, so tell Django the request was https (with
#   DJANGO_BEHIND_HTTPS_PROXY=true: Secure cookies, CSRF, https links in emails).
# - The player's real IP is CF-Connecting-IP, which Cloudflare sets itself (a player cannot
#   forge it). Caddy hands Django exactly that one address in X-Forwarded-For, so
#   TRUSTED_PROXIES=1. Only processes on this Mac can reach Caddy (127.0.0.1) without it.

:80 {
	encode zstd gzip

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	@django path /api/* /accounts/* /admin/* /ws/*
	handle @django {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			stream_close_delay 5m
		}
	}

	handle {
		reverse_proxy web:3000 {
			header_up X-Forwarded-Proto https
		}
	}
}
