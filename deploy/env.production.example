# Mẫu file .env cho server production. Trên server: cp deploy/env.production.example .env
# rồi sửa mọi chỗ có "doi-ten" / "thay-bang". Không commit file .env (đã có trong .gitignore).
# Ý nghĩa từng biến: docs/deploy.md mục "Bắt buộc khi deploy".

# --- Tên miền ---
# Caddy tự lấy chứng chỉ HTTPS cho tên này (DNS phải trỏ về IP server trước).
SITE_ADDRESS=poker.doi-ten.vn
DJANGO_ALLOWED_HOSTS=poker.doi-ten.vn
FRONTEND_URL=https://poker.doi-ten.vn
# Trang web nối WebSocket vào đây (ghi vào bản build của web, đổi thì phải build lại web).
NEXT_PUBLIC_DJANGO_WS=wss://poker.doi-ten.vn

# --- Django ---
DJANGO_DEBUG=false
# 32+ ký tự ngẫu nhiên. Tạo: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=thay-bang-chuoi-ngau-nhien
DJANGO_BEHIND_HTTPS_PROXY=true
# Caddy đứng thẳng trước Django: đúng một proxy.
TRUSTED_PROXIES=1

# --- Cơ sở dữ liệu và Redis (tên "db", "redis" là tên service trong docker-compose.prod.yml) ---
POSTGRES_DB=poker
POSTGRES_USER=poker
POSTGRES_PASSWORD=thay-bang-mat-khau-dai
DATABASE_URL=postgres://poker:thay-bang-mat-khau-dai@db:5432/poker
REDIS_URL=redis://redis:6379/0

# --- Email và Google (docs/huong-dan-google-smtp.md) ---
EMAIL_URL=
DEFAULT_FROM_EMAIL=Poker Friends <no-reply@poker.doi-ten.vn>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Phiên bản đang chạy (docs/runbook.md "Đổi bản" và "Quay về bản trước") ---
APP_VERSION=local
