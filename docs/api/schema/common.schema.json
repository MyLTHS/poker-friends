{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common",
  "description": "Building blocks shared by every WebSocket message and the REST API. See docs/api/ws-protocol.md.",
  "$defs": {
    "ProtocolVersion": {
      "title": "ProtocolVersion",
      "description": "Version of this protocol. Bumped only on a breaking change.",
      "const": 1
    },
    "RoomId": {
      "title": "RoomId",
      "type": "integer",
      "minimum": 1
    },
    "HandId": {
      "title": "HandId",
      "description": "Database id of the hand (Hand.pk), not the hand number within the room.",
      "type": "integer",
      "minimum": 1
    },
    "HandIdOrNull": {
      "title": "HandIdOrNull",
      "description": "The hand running when the message was sent, or null between hands.",
      "type": ["integer", "null"],
      "minimum": 1
    },
    "Version": {
      "title": "Version",
      "description": "Room event counter. Every state event adds exactly 1; replies carry the current value.",
      "type": "integer",
      "minimum": 0
    },
    "ServerTime": {
      "title": "ServerTime",
      "description": "UTC instant in ISO 8601 with a trailing Z, e.g. 2026-10-27T14:03:05.120Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "CommandId": {
      "title": "CommandId",
      "description": "Created by the client once per intent and resent unchanged on every retry. A UUID v4 is recommended.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$"
    },
    "PlayerId": {
      "title": "PlayerId",
      "description": "String form of the user's id (str(User.pk)), the id the engine uses.",
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "SeatNumber": {
      "title": "SeatNumber",
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "Chips": {
      "title": "Chips",
      "type": "integer",
      "minimum": 0
    },
    "Card": {
      "title": "Card",
      "description": "Rank (2-9, T, J, Q, K, A) then suit (c, d, h, s), e.g. As, 7h. A hidden card is ??.",
      "type": "string",
      "pattern": "^([2-9TJQKA][cdhs]|\\?\\?)$"
    },
    "VisibleCard": {
      "title": "VisibleCard",
      "description": "A face-up card; never ??.",
      "type": "string",
      "pattern": "^[2-9TJQKA][cdhs]$"
    },
    "ActionKind": {
      "title": "ActionKind",
      "description": "raise also covers an opening bet; its amount is the total to raise to.",
      "type": "string",
      "enum": ["fold", "check", "call", "raise"]
    },
    "LegalActions": {
      "title": "LegalActions",
      "description": "What the player to act may do, computed by the server (HandEngine.legal_actions).",
      "type": "object",
      "properties": {
        "can_fold": { "type": "boolean" },
        "can_check": { "type": "boolean" },
        "call_amount": { "$ref": "#/$defs/Chips" },
        "min_raise_to": { "type": ["integer", "null"], "minimum": 1 },
        "max_raise_to": { "type": ["integer", "null"], "minimum": 1 }
      },
      "required": ["can_fold", "can_check", "call_amount", "min_raise_to", "max_raise_to"],
      "additionalProperties": false
    },
    "HandPlayer": {
      "title": "HandPlayer",
      "description": "One player in the hand as the receiver may see them. cards hold ?? for every card the receiver may not see; they are empty once the player folded.",
      "type": "object",
      "properties": {
        "player_id": { "$ref": "#/$defs/PlayerId" },
        "seat": { "$ref": "#/$defs/SeatNumber" },
        "stack": { "$ref": "#/$defs/Chips" },
        "bet": { "$ref": "#/$defs/Chips" },
        "in_hand": { "type": "boolean" },
        "cards": {
          "type": "array",
          "items": { "$ref": "#/$defs/Card" },
          "maxItems": 2
        }
      },
      "required": ["player_id", "seat", "stack", "bet", "in_hand", "cards"],
      "additionalProperties": false
    },
    "Pot": {
      "title": "Pot",
      "type": "object",
      "properties": {
        "amount": { "$ref": "#/$defs/Chips" },
        "eligible": {
          "type": "array",
          "items": { "$ref": "#/$defs/PlayerId" }
        }
      },
      "required": ["amount", "eligible"],
      "additionalProperties": false
    },
    "HandView": {
      "title": "HandView",
      "description": "The hand as one receiver may see it: HandEngine.view_for(receiver) plus hand_id and hand_no. Spectators get view_for(None).",
      "type": "object",
      "properties": {
        "hand_id": { "$ref": "#/$defs/HandId" },
        "hand_no": { "type": "integer", "minimum": 1 },
        "button_seat": { "$ref": "#/$defs/SeatNumber" },
        "small_blind": { "type": "integer", "minimum": 1 },
        "big_blind": { "type": "integer", "minimum": 1 },
        "board": {
          "type": "array",
          "items": { "$ref": "#/$defs/VisibleCard" },
          "maxItems": 5
        },
        "pots": {
          "type": "array",
          "items": { "$ref": "#/$defs/Pot" }
        },
        "players": {
          "type": "array",
          "items": { "$ref": "#/$defs/HandPlayer" },
          "minItems": 2,
          "maxItems": 9
        },
        "actor": {
          "description": "The player to act, or null when nobody is (hand complete).",
          "anyOf": [{ "$ref": "#/$defs/PlayerId" }, { "type": "null" }]
        },
        "legal_actions": {
          "description": "Only for the receiver when they are the actor; null for everyone else.",
          "anyOf": [{ "$ref": "#/$defs/LegalActions" }, { "type": "null" }]
        },
        "complete": { "type": "boolean" }
      },
      "required": [
        "hand_id",
        "hand_no",
        "button_seat",
        "small_blind",
        "big_blind",
        "board",
        "pots",
        "players",
        "actor",
        "legal_actions",
        "complete"
      ],
      "additionalProperties": false
    },
    "SeatOccupant": {
      "title": "SeatOccupant",
      "description": "Who sits in a seat. stack is the room balance from the ledger: during a hand it is the balance before that hand; the live stack is in HandView.",
      "type": "object",
      "properties": {
        "seat": { "$ref": "#/$defs/SeatNumber" },
        "player_id": { "$ref": "#/$defs/PlayerId" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 50 },
        "stack": { "$ref": "#/$defs/Chips" },
        "sitting_out": { "type": "boolean" },
        "connected": { "type": "boolean" }
      },
      "required": ["seat", "player_id", "display_name", "stack", "sitting_out", "connected"],
      "additionalProperties": false
    },
    "RoomInfo": {
      "title": "RoomInfo",
      "type": "object",
      "properties": {
        "room_id": { "$ref": "#/$defs/RoomId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "status": { "type": "string", "enum": ["open", "playing", "closed"] },
        "max_seats": { "type": "integer", "minimum": 2, "maximum": 9 },
        "small_blind": { "type": "integer", "minimum": 1 },
        "big_blind": { "type": "integer", "minimum": 1 },
        "think_time_seconds": { "type": "integer", "minimum": 1 },
        "seven_deuce_bonus": { "$ref": "#/$defs/Chips" }
      },
      "required": [
        "room_id",
        "name",
        "status",
        "max_seats",
        "small_blind",
        "big_blind",
        "think_time_seconds",
        "seven_deuce_bonus"
      ],
      "additionalProperties": false
    },
    "Turn": {
      "title": "Turn",
      "description": "Whose turn it is and when the server acts for them (check if free, otherwise fold).",
      "type": "object",
      "properties": {
        "player_id": { "$ref": "#/$defs/PlayerId" },
        "seat": { "$ref": "#/$defs/SeatNumber" },
        "deadline": { "$ref": "#/$defs/ServerTime" },
        "think_time_seconds": { "type": "integer", "minimum": 1 }
      },
      "required": ["player_id", "seat", "deadline", "think_time_seconds"],
      "additionalProperties": false
    },
    "TableState": {
      "title": "TableState",
      "description": "Everything a client needs to draw the table from scratch, projected for one receiver.",
      "type": "object",
      "properties": {
        "room": { "$ref": "#/$defs/RoomInfo" },
        "you": {
          "description": "The receiver. seat is null for a spectator.",
          "type": "object",
          "properties": {
            "player_id": { "$ref": "#/$defs/PlayerId" },
            "seat": { "anyOf": [{ "$ref": "#/$defs/SeatNumber" }, { "type": "null" }] }
          },
          "required": ["player_id", "seat"],
          "additionalProperties": false
        },
        "seats": {
          "description": "Occupied seats only, ordered by seat.",
          "type": "array",
          "items": { "$ref": "#/$defs/SeatOccupant" },
          "maxItems": 9
        },
        "hand": { "anyOf": [{ "$ref": "#/$defs/HandView" }, { "type": "null" }] },
        "turn": { "anyOf": [{ "$ref": "#/$defs/Turn" }, { "type": "null" }] }
      },
      "required": ["room", "you", "seats", "hand", "turn"],
      "additionalProperties": false
    },
    "AppliedAction": {
      "title": "AppliedAction",
      "description": "One applied action. Like command.act: fold, check and call have no amount; raise has the total raised to. timeout is true when the server acted because the clock ran out.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "player_id": { "$ref": "#/$defs/PlayerId" },
            "seat": { "$ref": "#/$defs/SeatNumber" },
            "kind": { "type": "string", "enum": ["fold", "check", "call"] },
            "amount": { "type": "null" },
            "timeout": { "type": "boolean" }
          },
          "required": ["player_id", "seat", "kind", "amount", "timeout"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "player_id": { "$ref": "#/$defs/PlayerId" },
            "seat": { "$ref": "#/$defs/SeatNumber" },
            "kind": { "const": "raise" },
            "amount": { "type": "integer", "minimum": 1 },
            "timeout": { "type": "boolean" }
          },
          "required": ["player_id", "seat", "kind", "amount", "timeout"],
          "additionalProperties": false
        }
      ]
    },
    "PlayerResult": {
      "title": "PlayerResult",
      "description": "One player's outcome. stack is the room balance after the hand and the 7-2 bonus.",
      "type": "object",
      "properties": {
        "player_id": { "$ref": "#/$defs/PlayerId" },
        "seat": { "$ref": "#/$defs/SeatNumber" },
        "hand_net": { "type": "integer", "description": "Chips won (+) or lost (-) in the pot." },
        "seven_deuce_net": {
          "type": "integer",
          "description": "Seven-deuce bonus received (+) or paid (-); 0 when none."
        },
        "stack": { "$ref": "#/$defs/Chips" }
      },
      "required": ["player_id", "seat", "hand_net", "seven_deuce_net", "stack"],
      "additionalProperties": false
    },
    "SevenDeucePayment": {
      "title": "SevenDeucePayment",
      "type": "object",
      "properties": {
        "player_id": { "$ref": "#/$defs/PlayerId" },
        "seat": { "$ref": "#/$defs/SeatNumber" },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "description": "What this player actually paid: min(bonus, chips left after the pot)."
        }
      },
      "required": ["player_id", "seat", "amount"],
      "additionalProperties": false
    },
    "SevenDeuceAward": {
      "title": "SevenDeuceAward",
      "description": "Rule #27: the pot was taken holding 7-2 after everyone else folded. The two cards are shown to the whole table. total is the sum of payments: exactly what the winner received.",
      "type": "object",
      "properties": {
        "player_id": { "$ref": "#/$defs/PlayerId" },
        "seat": { "$ref": "#/$defs/SeatNumber" },
        "cards": {
          "type": "array",
          "items": { "$ref": "#/$defs/VisibleCard" },
          "minItems": 2,
          "maxItems": 2
        },
        "bonus": {
          "type": "integer",
          "minimum": 1,
          "description": "The room's bonus for this hand."
        },
        "payments": {
          "description": "One row per player who paid; players with 0 chips left are absent.",
          "type": "array",
          "items": { "$ref": "#/$defs/SevenDeucePayment" }
        },
        "total": { "$ref": "#/$defs/Chips" }
      },
      "required": ["player_id", "seat", "cards", "bonus", "payments", "total"],
      "additionalProperties": false
    },
    "RejectCode": {
      "title": "RejectCode",
      "description": "Stable reason a command was refused. See the table in docs/api/ws-protocol.md.",
      "type": "string",
      "enum": [
        "invalid_command",
        "command_id_reused",
        "no_active_hand",
        "stale_hand",
        "not_seated",
        "not_your_turn",
        "cannot_fold",
        "cannot_check",
        "nothing_to_call",
        "cannot_raise",
        "invalid_amount",
        "already_sitting_out",
        "not_sitting_out",
        "rate_limited",
        "internal_error"
      ]
    },
    "ProtocolErrorCode": {
      "title": "ProtocolErrorCode",
      "description": "Why a message without a usable command_id could not be handled.",
      "type": "string",
      "enum": ["invalid_json", "invalid_message", "unknown_type", "unsupported_protocol_version"]
    }
  }
}
