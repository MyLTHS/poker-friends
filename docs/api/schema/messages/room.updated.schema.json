{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RoomUpdatedMessage",
  "description": "State event: the room's settings or status changed (owner changed blinds or think time, the room was closed). Settings changed during a hand take effect from the next hand: this event is sent when they apply. See docs/api/ws-protocol.md.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "$ref": "../common.schema.json#/$defs/ProtocolVersion"
    },
    "type": {
      "const": "room.updated"
    },
    "room_id": {
      "$ref": "../common.schema.json#/$defs/RoomId"
    },
    "hand_id": {
      "$ref": "../common.schema.json#/$defs/HandIdOrNull"
    },
    "version": {
      "$ref": "../common.schema.json#/$defs/Version"
    },
    "server_time": {
      "$ref": "../common.schema.json#/$defs/ServerTime"
    },
    "payload": {
      "type": "object",
      "properties": {
        "room": {
          "$ref": "../common.schema.json#/$defs/RoomInfo"
        }
      },
      "required": [
        "room"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol_version",
    "type",
    "room_id",
    "hand_id",
    "version",
    "server_time",
    "payload"
  ],
  "additionalProperties": false
}
