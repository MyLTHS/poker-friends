{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HandCompletedMessage",
  "description": "State event: the hand is over and settled. Cards shown at showdown, and the 7-2 winner's two cards, are visible to everyone; folded cards stay hidden. showdown names the made hand of every player whose cards are face up after a showdown. Always about one hand, so hand_id is never null.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "$ref": "../common.schema.json#/$defs/ProtocolVersion"
    },
    "type": {
      "const": "hand.completed"
    },
    "room_id": {
      "$ref": "../common.schema.json#/$defs/RoomId"
    },
    "hand_id": {
      "$ref": "../common.schema.json#/$defs/HandId"
    },
    "version": {
      "$ref": "../common.schema.json#/$defs/Version"
    },
    "server_time": {
      "$ref": "../common.schema.json#/$defs/ServerTime"
    },
    "payload": {
      "type": "object",
      "properties": {
        "hand": {
          "$ref": "../common.schema.json#/$defs/HandView"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/PlayerResult"
          },
          "minItems": 2
        },
        "seven_deuce": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/SevenDeuceAward"
            },
            {
              "type": "null"
            }
          ]
        },
        "showdown": {
          "description": "One row per player whose cards are face up after a showdown, by seat; [] when the hand was won by folds.",
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/ShowdownHand"
          },
          "maxItems": 9
        }
      },
      "required": [
        "hand",
        "results",
        "seven_deuce",
        "showdown"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol_version",
    "type",
    "room_id",
    "hand_id",
    "version",
    "server_time",
    "payload"
  ],
  "additionalProperties": false
}
