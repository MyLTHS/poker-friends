{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HandCompletedMessage",
  "description": "State event: the hand is over and settled. Cards shown at showdown, and the 7-2 winner's two cards, are visible to everyone; folded cards stay hidden. showdown names the made hand of every player whose cards are face up after a showdown. Always about one hand, so hand_id is never null.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "$ref": "../common.schema.json#/$defs/ProtocolVersion"
    },
    "type": {
      "const": "hand.completed"
    },
    "room_id": {
      "$ref": "../common.schema.json#/$defs/RoomId"
    },
    "hand_id": {
      "$ref": "../common.schema.json#/$defs/HandId"
    },
    "version": {
      "$ref": "../common.schema.json#/$defs/Version"
    },
    "server_time": {
      "$ref": "../common.schema.json#/$defs/ServerTime"
    },
    "payload": {
      "type": "object",
      "properties": {
        "hand": {
          "$ref": "../common.schema.json#/$defs/HandView"
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/PlayerResult"
          },
          "minItems": 2
        },
        "seven_deuce": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/SevenDeuceAward"
            },
            {
              "type": "null"
            }
          ]
        },
        "showdown": {
          "description": "One row per player whose cards are face up after a showdown, by seat, once per board when the hand was run twice (so up to 18); [] when the hand was won by folds.",
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/ShowdownHand"
          },
          "maxItems": 18
        },
        "runouts": {
          "description": "Both boards of a hand run twice, each with what it paid; null otherwise.",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "../common.schema.json#/$defs/Runout"
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "rabbit_cards": {
          "description": "Rabbit hunt (room.rabbit_hunt): for a hand over before the river, the board cards that would have come next, in order, burns skipped. Only to look at, no chips move; [] otherwise. Never sent before the hand is over.",
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Card"
          },
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "required": [
        "hand",
        "results",
        "seven_deuce",
        "showdown",
        "runouts",
        "rabbit_cards"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol_version",
    "type",
    "room_id",
    "hand_id",
    "version",
    "server_time",
    "payload"
  ],
  "additionalProperties": false
}
