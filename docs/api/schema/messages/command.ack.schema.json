{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommandAckMessage",
  "description": "Reply to the sender only: the command was applied. duplicate is true when this command_id had already been applied and nothing was applied again. result_version is the version of the first state event the command caused.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "$ref": "../common.schema.json#/$defs/ProtocolVersion"
    },
    "type": {
      "const": "command.ack"
    },
    "room_id": {
      "$ref": "../common.schema.json#/$defs/RoomId"
    },
    "hand_id": {
      "$ref": "../common.schema.json#/$defs/HandIdOrNull"
    },
    "version": {
      "$ref": "../common.schema.json#/$defs/Version"
    },
    "server_time": {
      "$ref": "../common.schema.json#/$defs/ServerTime"
    },
    "payload": {
      "type": "object",
      "properties": {
        "command_id": {
          "$ref": "../common.schema.json#/$defs/CommandId"
        },
        "duplicate": {
          "type": "boolean"
        },
        "result_version": {
          "$ref": "../common.schema.json#/$defs/Version"
        }
      },
      "required": [
        "command_id",
        "duplicate",
        "result_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol_version",
    "type",
    "room_id",
    "hand_id",
    "version",
    "server_time",
    "payload"
  ],
  "additionalProperties": false
}
