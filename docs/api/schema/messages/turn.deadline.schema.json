{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnDeadlineMessage",
  "description": "State event: a player must act before deadline. legal_actions are in the last HandView the actor received. Always about one hand, so hand_id is never null.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "$ref": "../common.schema.json#/$defs/ProtocolVersion"
    },
    "type": {
      "const": "turn.deadline"
    },
    "room_id": {
      "$ref": "../common.schema.json#/$defs/RoomId"
    },
    "hand_id": {
      "$ref": "../common.schema.json#/$defs/HandId"
    },
    "version": {
      "$ref": "../common.schema.json#/$defs/Version"
    },
    "server_time": {
      "$ref": "../common.schema.json#/$defs/ServerTime"
    },
    "payload": {
      "type": "object",
      "properties": {
        "turn": {
          "$ref": "../common.schema.json#/$defs/Turn"
        }
      },
      "required": [
        "turn"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol_version",
    "type",
    "room_id",
    "hand_id",
    "version",
    "server_time",
    "payload"
  ],
  "additionalProperties": false
}
