{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AudienceUpdatedMessage",
  "description": "Notice (does not change version): who is watching without a seat. Sent to everyone when it changes, and to a new connection right after its table.snapshot.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "$ref": "../common.schema.json#/$defs/ProtocolVersion"
    },
    "type": {
      "const": "audience.updated"
    },
    "room_id": {
      "$ref": "../common.schema.json#/$defs/RoomId"
    },
    "hand_id": {
      "$ref": "../common.schema.json#/$defs/HandIdOrNull"
    },
    "version": {
      "$ref": "../common.schema.json#/$defs/Version"
    },
    "server_time": {
      "$ref": "../common.schema.json#/$defs/ServerTime"
    },
    "payload": {
      "type": "object",
      "properties": {
        "spectators": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Spectator"
          },
          "maxItems": 200
        }
      },
      "required": [
        "spectators"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol_version",
    "type",
    "room_id",
    "hand_id",
    "version",
    "server_time",
    "payload"
  ],
  "additionalProperties": false
}
