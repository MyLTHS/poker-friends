{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChatSendMessage",
  "description": "Say something in the room's chat. Not a command: no command_id, no ack; the sender sees their line come back as chat.message. Too fast: protocol.error rate_limited.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "$ref": "../common.schema.json#/$defs/ProtocolVersion"
    },
    "type": {
      "const": "chat.send"
    },
    "room_id": {
      "$ref": "../common.schema.json#/$defs/RoomId"
    },
    "payload": {
      "type": "object",
      "properties": {
        "text": {
          "$ref": "../common.schema.json#/$defs/ChatText"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol_version",
    "type",
    "room_id",
    "payload"
  ],
  "additionalProperties": false
}
