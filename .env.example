# Copy to .env and adjust. docker-compose.yml reads this file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

POSTGRES_DB=poker
POSTGRES_USER=poker
POSTGRES_PASSWORD=poker
DATABASE_URL=postgres://poker:poker@db:5432/poker
REDIS_URL=redis://redis:6379/0

# Host ports (container ports stay 5432/6379)
POSTGRES_PORT=5433
REDIS_PORT=6380
