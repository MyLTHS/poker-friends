# Copy to .env and adjust. docker-compose.yml reads this file.
# Chế độ debug: chỉ bật khi dev. Không đặt biến này thì mặc định TẮT (an toàn cho server).
# Production: false. (manage.py tự bật khi chưa có DJANGO_SECRET_KEY, pytest tự bật.)
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000

POSTGRES_DB=poker
POSTGRES_USER=poker
POSTGRES_PASSWORD=poker
DATABASE_URL=postgres://poker:poker@db:5432/poker
# Không dùng Redis: một process server, kênh phát tin nằm trong bộ nhớ (ADR-001).

# Host port (container port stays 5432)
POSTGRES_PORT=5433

# --- Tài khoản (B6) — hướng dẫn tạo key: docs/huong-dan-google-smtp.md ---
# Địa chỉ trang web (Next.js). Link trong email và cuối luồng Google đưa người dùng về đây.
FRONTEND_URL=http://localhost:3000

# Chạy sau Caddy (HTTPS): true. Dev (http://localhost): để false. Xem docs/deploy.md.
DJANGO_BEHIND_HTTPS_PROXY=false
# Chỉ có tác dụng khi DJANGO_BEHIND_HTTPS_PROXY=true: trình duyệt nhớ "chỉ dùng HTTPS" bao lâu
# (giây). Mặc định 30 ngày; tăng lên 31536000 (1 năm) khi HTTPS đã chạy ổn định. Bật subdomain
# chỉ khi mọi subdomain của tên miền đều có HTTPS.
# DJANGO_HSTS_SECONDS=2592000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=false

# Số reverse proxy (Caddy...) đứng trước Django. 0 khi chạy dev. Đặt đúng số proxy khi deploy,
# nếu không thì rate limit theo IP coi mọi người là một (IP của proxy). Đặt lớn hơn số proxy thật
# thì người dùng tự khai IP giả được.
TRUSTED_PROXIES=0

# Gửi email. Để trống: email (link xác minh, link đặt lại mật khẩu) chỉ in ra console của Django.
# Gmail: smtp://ten%40gmail.com:mat-khau-ung-dung@smtp.gmail.com:587  (@ viết thành %40)
EMAIL_URL=
DEFAULT_FROM_EMAIL=Poker Friends <no-reply@localhost>

# Đăng nhập Google. Để trống một trong hai: tắt Google, trang web ẩn nút "Đăng nhập bằng Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
